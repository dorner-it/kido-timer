# Local development env. Copy to .env (gitignored) and edit.

ENV=dev
LOG_LEVEL=info
AWS_REGION=eu-central-1

TABLE_NAME=ki-do-timer-dev

# After `terraform apply`, populate these from `terraform output`:
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_DOMAIN=
COGNITO_REDIRECT_URI=http://localhost:9000/api/auth/callback
FRONTEND_BASE_URL=http://localhost:4321
