---
import '../styles/global.css';

interface Props {
  title: string;
  /** Defaults to "light"; pass "dark" for the decider focus mode. */
  theme?: 'light' | 'dark';
  /** Hides the global TopBar. Used by the public decider page. */
  bare?: boolean;
}

const { title, theme = 'light', bare = false } = Astro.props;
---

<!doctype html>
<html lang="de" data-theme={theme}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Antonio:wght@400;500;700&family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,500;12..96,600;12..96,700&family=JetBrains+Mono:wght@400;500;600&display=swap"
    />

    <title>{title}</title>
  </head>
  <body>
    <slot name="topbar" />
    {!bare && <div data-topbar-slot></div>}
    <slot />
  </body>
</html>
