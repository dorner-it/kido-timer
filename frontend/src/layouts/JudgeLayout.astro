---
// Layout of the judge (Strafrichter) pages. Deliberately self-contained:
// no external fonts / CDNs (system font stack via the Tailwind
// fallbacks) so the same pages also work when the desktop serves them
// over plain HTTP in a venue LAN without internet (on-prem mode).
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class="judge-app">
    <slot />
  </body>
</html>
