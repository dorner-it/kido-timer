---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TopBar from '../../components/react/TopBar.tsx';
import CompetitionDetail from '../../components/react/CompetitionDetail.tsx';

const { id } = Astro.params;
if (!id) return Astro.redirect('/competitions');
---

<BaseLayout title="Wettkampf – KI-DO Timer">
  <TopBar client:load />
  <CompetitionDetail id={id} client:load />
</BaseLayout>
