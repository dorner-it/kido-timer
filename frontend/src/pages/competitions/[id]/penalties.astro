---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import TopBar from '../../../components/react/TopBar.tsx';
import PenaltyReview from '../../../components/react/PenaltyReview.tsx';

const { id } = Astro.params;
if (!id) return Astro.redirect('/competitions');
---

<BaseLayout title="Strafen prüfen – KI-DO Timer">
  <TopBar client:load context="Strafen prüfen" />
  <PenaltyReview id={id} client:load />
</BaseLayout>
