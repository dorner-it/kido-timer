---
import BaseLayout from '../layouts/BaseLayout.astro';
import LoginForm from '../components/react/LoginForm.tsx';
---

<BaseLayout title="Anmelden – KI-DO Timer" bare>
  <main class="grid min-h-screen lg:grid-cols-[1.1fr_1fr]">
    <aside
      class="relative hidden overflow-hidden bg-ink-50 lg:flex"
      data-theme="dark"
    >
      <div class="absolute inset-0 scanlines opacity-30"></div>
      <div class="relative flex flex-1 flex-col justify-between p-12">
        <span class="label text-ink-200">KiDo · Wettkampf-Kontrollstand</span>
        <span
          class="font-stencil text-[160px] font-bold leading-[0.85] tracking-tight text-ink-50/85 mix-blend-screen"
        >
          KI<br />DO
        </span>
        <p class="font-mono text-[11px] uppercase tracking-[0.22em] text-ink-200">
          TRV Kocab · Löschangriff · Staffel · Hindernisbahn
        </p>
      </div>
    </aside>
    <section class="flex items-center justify-center p-10">
      <LoginForm client:load />
    </section>
  </main>
</BaseLayout>
