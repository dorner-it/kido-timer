---
import JudgeLayout from '../../../../layouts/JudgeLayout.astro';
import DeciderPad from '../../../../components/react/DeciderPad.tsx';

const { owner_sub, slot, token } = Astro.params;
if (!owner_sub || !slot || !token) {
  return new Response('Bad request', { status: 400 });
}

const slotNumber = Number(slot);
if (!Number.isInteger(slotNumber) || slotNumber < 1 || slotNumber > 4) {
  return new Response('Invalid slot', { status: 400 });
}
---

<JudgeLayout title={`Strafrichter B${slot} – KI-DO Timer`}>
  <DeciderPad
    ownerSub={owner_sub}
    slotIndex={slot}
    token={token}
    client:load
  />
</JudgeLayout>
