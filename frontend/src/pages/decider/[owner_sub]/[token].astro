---
// Strafrichter app (station token): one shared token per
// Tagesveranstaltung; the judge picks station (and, if configured, lane)
// inside the app. The slot-based route at `/decider/:owner/:slot/:token`
// stays mounted for QR codes minted before the stations feature.
//
// Uses JudgeLayout (no external fonts/CDNs) so the page also works when
// served by the desktop over plain HTTP in a venue LAN. The API base can
// be overridden at runtime via `window.__KIDO_API_BASE__` (see
// src/lib/api-base.ts).
import JudgeLayout from '../../../layouts/JudgeLayout.astro';
import JudgeApp from '../../../components/react/judge/JudgeApp.tsx';

const { owner_sub, token } = Astro.params;
if (!owner_sub || !token) {
  return new Response('Bad request', { status: 400 });
}
---

<JudgeLayout title="Strafrichter – KI-DO Timer">
  <JudgeApp ownerSub={owner_sub} token={token} client:load />
</JudgeLayout>
