---
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import TopBar from '../../../../../components/react/TopBar.tsx';
import ResultsView from '../../../../../components/react/ResultsView.tsx';

const { id, discipline_id } = Astro.params;
if (!id) return Astro.redirect('/events');
if (!discipline_id) return Astro.redirect(`/events/${id}`);
---

<BaseLayout title="Ergebnisse – KI-DO Timer" auth="required">
  <div class="no-print print:hidden">
    <TopBar client:load context="Ergebnisse" />
  </div>
  <ResultsView eventId={id} disciplineId={discipline_id} client:load />
</BaseLayout>
