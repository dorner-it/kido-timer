env    = "prod"
region = "eu-central-1"

cognito_hosted_ui_domain_prefix = "kido-timer"

# Both URLs are registered with Cognito; backend picks one via
# COGNITO_REDIRECT_URI (Lambda env var = the Vercel URL since the frontend
# proxies /api/* to the API Gateway, so the cookie lands on the Vercel
# domain).
cognito_callback_urls = [
  "http://localhost:9000/api/auth/callback",
  "https://idr9teznt4.execute-api.eu-central-1.amazonaws.com/api/auth/callback",
  "https://ki-do-timer-web.vercel.app/api/auth/callback",
]
cognito_redirect_uri = "https://ki-do-timer-web.vercel.app/api/auth/callback"

cognito_logout_urls = [
  "http://localhost:4321/",
  "https://ki-do-timer-web.vercel.app/",
]
frontend_base_url = "https://ki-do-timer-web.vercel.app"

cors_allowed_origins = ["https://ki-do-timer-web.vercel.app"]
